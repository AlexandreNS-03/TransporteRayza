# URL pública del backend. En desarrollo usa http://localhost:8080 si no se define.
# Producción: VITE_API_URL=https://transporterayza-production.up.railway.app
VITE_API_URL=

# La pasarela Izipay NO necesita ninguna llave acá: la clave pública viaja desde el
# backend junto con el formToken de cada compra. Las credenciales se configuran solo
# en el servidor (IZIPAY_* en Railway).

# Microsoft Clarity: mapas de calor y grabación de sesiones. Trae un Project ID por
# defecto y solo carga en producción (y tras aceptar cookies). Define VITE_CLARITY_ID
# solo si quieres usar OTRO proyecto.
VITE_CLARITY_ID=

# Google Analytics 4 (opcional): trae un Measurement ID por defecto y solo carga en
# el build de producción. Define VITE_GA_ID solo si quieres usar OTRA cuenta.
VITE_GA_ID=
