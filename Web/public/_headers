# Encabezados de seguridad para la web del cliente.
#
# IMPORTANTE: este archivo vive en public/ a propósito. El sitio se publica
# arrastrando la carpeta dist/ a Netlify, y netlify.toml queda FUERA de dist,
# así que sus encabezados nunca se aplicaban. Vite sí copia public/_headers
# dentro de dist/, que es lo que Netlify lee en un despliegue manual.
# Si algún día se despliega desde Git, netlify.toml también funciona: los dos
# declaran lo mismo.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.micuentaweb.pe https://secure.micuentaweb.pe https://sdk.mercadopago.com https://www.mercadopago.com https://http2.mlstatic.com https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://static.micuentaweb.pe https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net https://static.micuentaweb.pe; img-src 'self' data: blob: https:; connect-src 'self' https://transporterayza-production.up.railway.app https://api.micuentaweb.pe https://static.micuentaweb.pe https://secure.micuentaweb.pe https://api.mercadopago.com https://www.mercadolibre.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com; frame-src 'self' https://static.micuentaweb.pe https://*.micuentaweb.pe https://sdk.mercadopago.com https://*.mercadopago.com https://www.mercadolibre.com
